---
import "@/styles/globals.css";
import ThemeScript from "@jianyuelab-org/can-ui/components/ThemeScript.astro";
import Frame from "@/components/Frame.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { buildWorkspaces } from "@jianyuelab-org/can-ui";
import { buildNavigation, buildSecondary, SITE_ORIGINS } from "@/lib/nav";

interface Props {
  title?: string;
}
const { title = "教员与管理 · Cerulean Aviation Network" } = Astro.props;

const locale = getLocale(Astro.cookies);
const frameMessages = getMessages(locale, "frame");
const t = useTranslations(locale, "frame");

/**
 * 侧栏按身份分三份 —— 教员（8）、监理（11）、管理员（12）。门槛读的是会话里的
 * rating，can-api 每个请求都解一次，所以一次晋升在下一次翻页时就生效，而不是等
 * 到下次登录。分界和它的边角写在 `lib/nav.ts`。
 *
 * **这是便利，不是边界。** 中间件按同一组常量给不够格的人渲染 `NoAccess`
 * （`src/middleware.ts`、`src/lib/access.ts`）。真正的判断仍然在 can-api 每条路由
 * 自己的守卫上，外加每个 handler 内部按 division 的那一层。
 */
const user = Astro.locals.user;
const navigation = buildNavigation(t, user?.rating);
const secondary = buildSecondary(t, {
  locale,
  rating: user?.rating,
  signedIn: !!user,
});
/**
 * 分区切换器，来自 can-ui。**高亮的是「管制员」而不是新开一格**：这些页面是从
 * 管制员中心的侧栏点进来的，教员做完手上的事要回去的也是那里。
 *
 * `origins` 和 `buildSecondary` 用同一份 `SITE_ORIGINS`（`lib/nav.ts`）。
 */
const workspaces = buildWorkspaces(t, {
  current: "portal",
  rating: user?.rating,
  origins: SITE_ORIGINS,
});
/** 账户菜单显示名字和 `#CID`；CID 是会话里的 `username`。 */
const frameUser = user
  ? { name: user.name, id: user.username, rating: user.rating }
  : null;
/** 被拒的请求由中间件改写到 `/denied`；侧栏按成员请求的地址高亮。 */
const pathname = Astro.originPathname;
---

<!doctype html>
<html lang={locale} class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <meta name="theme-color" content="#4c92c1" />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body>
    <Frame
      locale={locale}
      pathname={pathname}
      nav={navigation}
      secondary={secondary}
      workspaces={workspaces}
      user={frameUser}
      aipAccess={user?.aipAccess ?? 0}
      messages={frameMessages}
      origins={SITE_ORIGINS}
      client:load
    >
      <slot />
    </Frame>
  </body>
</html>
