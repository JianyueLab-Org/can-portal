---
import AppLayout from "@/layouts/AppLayout.astro";
import SuperRoster from "@/components/SuperRoster.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { chromeMessages } from "@/lib/chrome";
import { RATING_ADMIN, RATING_SUP } from "@jianyuelab-org/can-ui/sites";

const locale = getLocale(Astro.cookies);
const messages = getMessages(locale, "roster.super");
const sessionUserId = Astro.locals.user?.username ?? "";
const canEditStatus = (Astro.locals.user?.rating ?? 0) >= RATING_SUP;
const canEditInstructor = (Astro.locals.user?.rating ?? 0) >= RATING_ADMIN;
const tf = useTranslations(getLocale(Astro.cookies), "frame");
---

<AppLayout title={tf("instructors.items.roster")}>
  <SuperRoster
    messages={messages}
    chrome={chromeMessages(locale)}
    locale={locale}
    sessionUserId={sessionUserId}
    canEditStatus={canEditStatus}
    canEditInstructor={canEditInstructor}
    client:load
  />
</AppLayout>
