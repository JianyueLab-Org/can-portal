---
import { RATING_INSTRUCTOR } from "@jianyuelab-org/can-ui/sites";
import { homePath } from "@/lib/nav";

/**
 * 门户首页：302 到成员看得见的第一页，和侧栏读同一份数据。
 * 中间件已经挡掉 8 级以下的人；万一没有可见的页面，改写到 `/denied`。
 */
const target = homePath(Astro.locals.user?.rating);
if (!target) {
  Astro.locals.noAccess = { kind: "rating", required: RATING_INSTRUCTOR };
  return Astro.rewrite("/denied");
}
return Astro.redirect(target, 302);
---
