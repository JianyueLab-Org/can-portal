---
import AppLayout from "@/layouts/AppLayout.astro";
import ManagePolls from "@/components/ManagePolls.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { chromeMessages } from "@/lib/chrome";

/**
 * 投票管理 —— SUP/ADM（`/super/*` 前缀，中间件按 11 级判）。
 */
const locale = getLocale(Astro.cookies);
const messages = getMessages(locale, "polls.manage");
const tf = useTranslations(locale, "frame");
---

<AppLayout title={tf("pollsManage")}>
  <ManagePolls
    messages={messages}
    chrome={chromeMessages(locale)}
    client:load
  />
</AppLayout>
