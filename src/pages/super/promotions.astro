---
import AppLayout from "@/layouts/AppLayout.astro";
import SuperPromotions from "@/components/SuperPromotions.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { RATING_SUP } from "@jianyuelab-org/can-ui/sites";

const messages = getMessages(getLocale(Astro.cookies), "promotion.super");
const sessionUserId = Astro.locals.user?.username ?? "";
const viewerRating = Astro.locals.user?.rating ?? 0;
const canReview = viewerRating >= RATING_SUP;
const tf = useTranslations(getLocale(Astro.cookies), "frame");
---

<AppLayout title={tf("admin.items.promote")}>
  <SuperPromotions
    messages={messages}
    sessionUserId={sessionUserId}
    viewerRating={viewerRating}
    canReview={canReview}
    client:load
  />
</AppLayout>
