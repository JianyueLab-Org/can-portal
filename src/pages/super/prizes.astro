---
import AppLayout from "@/layouts/AppLayout.astro";
import ManagePrizes from "@/components/ManagePrizes.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";

const locale = getLocale(Astro.cookies);
const messages = getMessages(locale, "rewards.manage");
const tf = useTranslations(locale, "frame");
---

<AppLayout title={tf("prizesManage")}>
  <ManagePrizes messages={messages} client:load />
</AppLayout>
