---
import AppLayout from "@/layouts/AppLayout.astro";
import ManageFeedback from "@/components/ManageFeedback.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";

const locale = getLocale(Astro.cookies);
const messages = getMessages(locale, "feedback.manage");
const tf = useTranslations(locale, "frame");
---

<AppLayout title={tf("feedbackManage")}>
  <ManageFeedback messages={messages} client:load />
</AppLayout>
