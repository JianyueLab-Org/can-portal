---
import { NotFound } from "@jianyuelab-org/can-ui";
import AppLayout from "@/layouts/AppLayout.astro";
import { getLocale } from "@/lib/i18n";
import { SITE_ORIGINS } from "@/lib/nav";

const locale = getLocale(Astro.cookies);
Astro.response.status = 404;

/**
 * 404 也套在外壳里，而不是像主站那样是一张独立的落地页。
 *
 * 这个站整站要登录而且要评级，能看见 404 的人一定是教员或以上，手边留着侧栏
 * 比留着一张漂亮的图更有用 —— 他们要的是「那我该去哪儿」。
 */
---

<AppLayout title="404">
  <NotFound current="portal" locale={locale} origins={SITE_ORIGINS} />
</AppLayout>
