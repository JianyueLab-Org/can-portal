{
  "name": "can-portal",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "astro dev --port 4328",
    "build": "astro build",
    "preview": "astro preview --port 4328",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && node ./scripts/typecheck-vue.mjs",
    "typecheck:astro": "astro check",
    "typecheck:vue": "node ./scripts/typecheck-vue.mjs",
    "lint": "bun run format:check && bun run typecheck"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/vue": "^7.0.0",
    "@jianyuelab-org/can-ui": "^0.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.8"
  }
}
